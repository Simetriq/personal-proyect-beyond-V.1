generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Campaign {
  id         String      @id @default(uuid())
  name       String
  gmId       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  gm         User        @relation(fields: [gmId], references: [id])
  characters Character[]
}

model Character {
  id              String         @id @default(uuid())
  name            String
  campaignId      String
  hp              Int
  max_hp          Int
  ki              Int
  zeon            Int
  initiative_base Int
  gold            Float          @default(0)
  resistances     String
  dotes           String
  kiAbilities     String         @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Fase 6: Críticos y Sangrado
  isBleeding      Boolean        @default(false)
  bleedingDamage  Int            @default(0)
  
  // Fase 6: Cansancio
  maxFatigue      Int            @default(5)
  currentFatigue  Int            @default(5)
  
  // Fase 6: Acumulación Mágica
  isChanneling    Boolean        @default(false)
  channeledZeon   Int            @default(0)
  targetSpellId   String?

  // Fase 7: Combate a distancia y Artes Marciales
  reloadTurnsLeft Int            @default(0)
  martialStyles   String         @default("[]")

  // Fase 10 (Subfases B, C, D, E): Fisiología, Razas, Existenciales y Bases
  strength        Int            @default(5)
  dexterity       Int            @default(5)
  agility         Int            @default(5)
  constitution    Int            @default(5)
  intelligence    Int            @default(5)
  power           Int            @default(5)
  willpower       Int            @default(5)
  perception      Int            @default(5)
  
  appearance      Int            @default(5)
  size            Int            @default(10)
  nephilimType    String?
  hasInhumanity   Boolean        @default(false)
  hasZen          Boolean        @default(false)
  isDead          Boolean        @default(false)

  // Fase 9: Progresión y Puntos de Desarrollo
  level           Int            @default(1)
  category        String         @default("Freelancer")
  totalDP         Int            @default(600)
  spentDP         Int            @default(0)
  dpDistribution  String         @default("{}")

  activeEffects   ActiveEffect[]
  inventoryItems  InventoryItem[]
  campaign        Campaign       @relation(fields: [campaignId], references: [id])
}

model ActiveEffect {
  id              String    @id @default(uuid())
  name            String
  characterId     String
  modifiers       String
  duration_rounds Int
  createdAt       DateTime  @default(now())
  character       Character @relation(fields: [characterId], references: [id])
}

model KiAbility {
  id                String   @id
  name              String
  cmCost            Int
  prerequisites     String   @default("[]")
  effectType        String
  kiCostActivation  Int
  kiCostMaintenance Int      @default(0)
  description       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   // "WEAPON", "ARMOR", "CONSUMABLE", "MISC"
  baseDamage  Int?
  modifiers   String?    // e.g. { "FIL": 10, "CON": 5 }
  weight      Float?
  price       Float?
  
  // Fase 6: Choque de Armas
  isWeapon    Boolean  @default(false)
  breakage    Int      @default(0) // ROT
  fortitude   Int      @default(0) // ENT
  
  // Fase 7: Propiedades de arma avanzadas
  hasPresa         Boolean  @default(false)
  presaStrength    Int      @default(0)
  reloadTurns      Int      @default(0)
  isRanged         Boolean  @default(false)

  // Fase 10: Modificadores de equipo
  isEnormous       Boolean  @default(false)
  material         String?

  inventoryItems InventoryItem[]
}

model InventoryItem {
  id          String   @id @default(uuid())
  characterId String
  itemId      String
  quantity    Int      @default(1)
  equipped    Boolean  @default(false)
  isBroken    Boolean  @default(false) // Fase 6: Rotura de armas
  quality     Int      @default(0)     // Fase 10: Calidad de Forja
  
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id])
}
